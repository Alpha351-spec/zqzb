{
  "name": "zqzb-e2e-tests",
  "version": "1.0.0",
  "description": "杂七杂八工具箱 自动化端到端测试",
  "scripts": {
    "test": "npx playwright test",
    "test:desktop": "npx playwright test --project=desktop-chrome",
    "test:mobile": "npx playwright test --project=mobile-chrome",
    "test:pages": "npx playwright test tests/pages.spec.ts",
    "test:image": "npx playwright test tests/image-tools.spec.ts",
    "test:text": "npx playwright test tests/text-tools.spec.ts",
    "test:encode": "npx playwright test tests/encode-tools.spec.ts",
    "test:generate": "npx playwright test tests/generate-tools.spec.ts",
    "test:pdf": "npx playwright test tests/pdf-tools.spec.ts",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
